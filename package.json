{
  "name": "neocareai",
  "version": "0.1.0",
  "private": true,
  "description": "NeocareAI - neonatal monitoring and clinical decision-support prototype (synthetic data only)",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:check": "node scripts/db-check.mjs",
    "migrate": "npm run migrate -w @neocareai/api",
    "seed": "npm run seed -w @neocareai/api",
    "api": "npm run start -w @neocareai/api",
    "test": "vitest run",
    "seed:reset": "npm run seed -w @neocareai/api -- --reset",
    "web": "npm run dev -w @neocareai/web",
    "gateway": "npm run start -w @neocareai/device-gateway",
    "simulate": "npm run start -w @neocareai/simulator --"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "supertest": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "@types/cors": "^2.8.17"
  }
}