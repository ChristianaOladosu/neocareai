# Copy to .env. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://neocare:neocare_dev_only@localhost:5432/neocareai
SESSION_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173
# Optional Azure AI (core product works without it)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AI_PROVIDER=mock
GATEWAY_API_KEY=change-me-gateway-key-min-16-chars

# Gateway
GATEWAY_PORT=4100
# Staleness: readings older than this are shown as "not current"
STALE_AFTER_SECONDS=120
# AI assistance. Default is the local Demo Mode provider (no Azure, no cost, no network).
AI_ENABLED=true
# mock = Demo Mode (local templates) is the default. Set to azure to make Azure OpenAI the default for AI requests.
# Clinicians can still choose Demo Mode explicitly per request. Azure is never used unless configured below.
# --- Azure OpenAI (optional; never commit real values; keep this file's values EMPTY and put real ones only in your private .env) ---
# Auth: 'key' (default, uses AZURE_OPENAI_API_KEY) or 'entra' (keyless Microsoft Entra ID; needs: npm install @azure/identity)
AZURE_OPENAI_AUTH=key
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional tuning. Leave temperature unset unless your model accepts it (some newer model families reject it).
# AZURE_OPENAI_TEMPERATURE=0
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1500
